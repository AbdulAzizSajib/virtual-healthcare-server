model Patient {
    id String @id @default(uuid(7))

    name          String
    email         String    @unique
    profilePhoto  String?
    contactNumber String?
    address       String?
    isDeleted     Boolean?  @default(false)
    deletedAt     DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // relation with User as patient

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    // relation with Appointment
    appointments      Appointment[]
    // relation with Review
    reviews           Review[]
    // relation with PatientHealthData
    patientHealthData PatientHealthData?
    // relation with MedicalReport
    medicalReports    MedicalReport[]
    // relation with Prescription
    prescriptions     Prescription[]

    @@index([email], name: "idx_patient_email")
    @@index([isDeleted], name: "idx_patient_isDeleted")
    @@map("patients")
}
